# Copy this file to `.env` and fill in the real values. Never commit `.env`.
# Generate APP_ENCRYPTION_KEY with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Groq API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq model IDs — see https://console.groq.com/docs/models
GROQ_MODEL_SMART=llama-3.1-70b-versatile
GROQ_MODEL_FAST=llama-3.1-8b-instant
GROQ_MODEL_AUDIO=distil-whisper-large-v3-en

# Random 32-byte secret used to encrypt uploaded documents at rest.
APP_ENCRYPTION_KEY=replace-with-a-random-32-byte-token

SQLALCHEMY_DATABASE_URL=sqlite:///./clause_compass.db

# Set to 1 to use the offline MockProvider instead of calling Groq.
MOCK_LLM=0
