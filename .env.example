# Copy this file to `.env` and fill in the real values. Never commit `.env`.
# Generate APP_ENCRYPTION_KEY with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Groq API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq model IDs — see https://console.groq.com/docs/models
GROQ_MODEL_SMART=llama-3.1-70b-versatile
GROQ_MODEL_FAST=llama-3.1-8b-instant
GROQ_MODEL_AUDIO=whisper-large-v3

# Replace this placeholder with a 64-character hex or 44-character base64 secret.
# The placeholder below is rejected by the server at startup.
APP_ENCRYPTION_KEY=replace-with-a-random-32-byte-token

# Optional PostgreSQL connection for persistence.
# DATABASE_URL=postgresql://user:password@localhost:5432/clause_compass

# Optional allowed origins (comma-separated); production origins must be listed here.
# CORS_ORIGIN=https://clause-compass.example.com

# Set to 1 to use the offline MockProvider instead of calling Groq.
MOCK_LLM=0
